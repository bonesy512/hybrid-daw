# ─────────────────────────────────────────────────────────────
# HybridDAW — root .gitignore (Rust/Cargo + Tauri + Next.js/Node)
# ─────────────────────────────────────────────────────────────

# ── Node / package managers ──────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Next.js ──────────────────────────────────────────────────
.next/
out/
next-env.d.ts
*.tsbuildinfo
.vercel

# ── Build output / coverage ──────────────────────────────────
build/
dist/
coverage/
.turbo/

# ── Environment files ────────────────────────────────────────
.env
.env.*
!.env.example

# ── Rust / Cargo ─────────────────────────────────────────────
# Cargo.lock IS committed: HybridDAW ships a binary application.
target/
**/*.rs.bk
*.pdb

# ── Tauri ────────────────────────────────────────────────────
src-tauri/target/
src-tauri/gen/schemas/
src-tauri/WixTools/

# ── Editors / IDEs ───────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ── OS cruft ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Misc ─────────────────────────────────────────────────────
*.log
*.pem
